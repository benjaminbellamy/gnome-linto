<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>ai.linto.gnomelinto</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-or-later</project_license>
  <name>LinTO</name>
  <summary>Send a local audio stream to a LinTO server</summary>
  <description>
    <p>
      LinTO captures a local audio input and sends it to a LinTO Studio server
      over SRT for live transcription and translation.
    </p>
    <p>Features:</p>
    <ul>
      <li>Select a PipeWire audio input and watch a live level meter.</li>
      <li>Pre-flight network checks for the adapter, local and public IP,
        internet access, and the LinTO server reachability.</li>
      <li>Stream over SRT with automatic reconnection if the link drops.</li>
      <li>Live transport statistics saved per URL, with first and latest
        streaming timestamps.</li>
    </ul>
  </description>
  <launchable type="desktop-id">ai.linto.gnomelinto.desktop</launchable>
  <developer id="com.linagora">
    <name>Benjamin Bellamy</name>
  </developer>
  <url type="homepage">https://github.com/benjaminbellamy/gnome-linto</url>
  <url type="bugtracker">https://github.com/benjaminbellamy/gnome-linto/issues</url>
  <url type="vcs-browser">https://github.com/benjaminbellamy/gnome-linto</url>
  <content_rating type="oars-1.1"/>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/benjaminbellamy/gnome-linto/main/data/screenshots/main.png</image>
      <caption>Streaming a microphone to a LinTO server</caption>
    </screenshot>
  </screenshots>
  <releases>
    <release version="1.0.10" date="2026-07-20">
      <description>
        <p>Adds an SRT latency setting on the main window, so a jittery link has
          more time to recover lost packets before the server drops them. It
          defaults to 500 ms, is shown only for SRT addresses, is locked while
          streaming, and a latency value already in the URL is respected.</p>
      </description>
    </release>
    <release version="1.0.9" date="2026-07-18">
      <description>
        <p>You can now import stream addresses from a CSV file. Pick which
          columns hold the label and the address (they are guessed
          automatically from the first rows), preview the first rows, and
          import. Addresses already saved are skipped, and a repeated label
          gets a number so nothing is overwritten. A new Remove All button
          clears every saved address at once, after a confirmation.</p>
      </description>
    </release>
    <release version="1.0.8" date="2026-07-09">
      <description>
        <p>Fixes streaming stability. Switching to another address, restarting a
          stream, and reconnecting after a drop now work reliably (the internal
          audio path was rebuilt). The stream keeps sending a continuous audio
          signal even if the input briefly drops. Adds a live data rate meter, a
          CPU usage indicator, and a level reading in dBFS, so you can confirm
          audio is really being sent and see whether the machine is loaded.</p>
      </description>
    </release>
    <release version="1.0.7" date="2026-07-08">
      <description>
        <p>The stream now always sends a continuous audio signal (silence when
          the input drops out), so a brief input gap no longer breaks the server
          session, and a dropped connection waits at least 5 seconds before
          reconnecting. You can switch the stream address while streaming (it
          asks first, then stops the current stream and starts the new one), and
          the address being streamed cannot be edited or removed until you stop.
          Picking an address now applies it and closes the list. A new data rate
          meter and a dBFS reading on the input level let you confirm audio is
          really being sent. Deleting the last saved address now removes it for
          good.</p>
      </description>
    </release>
    <release version="1.0.6" date="2026-07-07">
      <description>
        <p>Adds a paste button to the stream address field, enabled only when
          the clipboard holds a valid address. The saved address list now shows
          SRT addresses correctly. After stopping a stream, the same address
          cannot be restarted for a few seconds, with a countdown on the button;
          switching to another address starts right away.</p>
      </description>
    </release>
    <release version="1.0.5" date="2026-07-07">
      <description>
        <p>The network checks now test IPv4 and IPv6 separately, showing the
          local and public address for each. A missing IPv4 route is flagged as
          a problem (the LinTO server is IPv4 only), while a missing IPv6 route
          is shown as unavailable without counting as a failure.</p>
      </description>
    </release>
    <release version="1.0.4" date="2026-07-06">
      <description>
        <p>Adds several saved stream addresses with labels, so you can pick
          which one to stream to (the active one is shown on the main window).
          The audio input is now captured as a single mono channel and stays
          open, so it is no longer recreated when streaming starts or pauses.
          Shows a clear message when the address cannot be reached, and opens
          the address list from the main window instead of the menu.</p>
      </description>
    </release>
    <release version="1.0.3" date="2026-07-03">
      <description>
        <p>Adds a Debug Mode dialog that records a per-session log file (with the
          network checks and stream format) to help track down streaming
          problems. Off by default.</p>
      </description>
    </release>
    <release version="1.0.2" date="2026-07-02">
      <description>
        <p>The network refresh button now re-runs all checks, including the
          upload bandwidth measurement.</p>
      </description>
    </release>
    <release version="1.0.1" date="2026-07-01">
      <description>
        <p>The SRT stream now uses Opus (16 kHz mono) instead of AC-3, for much
          lower CPU and bandwidth, better suited to speech recognition. RTMP is
          unchanged.</p>
      </description>
    </release>
    <release version="1.0.0" date="2026-07-01">
      <description>
        <p>Adds remote control from Stream Controller over a built-in WebSocket
          server: start and pause streaming and read live status from a Stream
          Deck. Includes a Stream Controller dialog (enable, port, password,
          address) and shows the connection status on the main window.</p>
      </description>
    </release>
    <release version="0.1.2" date="2026-07-01">
      <description>
        <p>Adds network latency and upload bandwidth checks, names the PipeWire
          input "LinTO", opens the address dialog on first launch, and locks the
          address while streaming.</p>
      </description>
    </release>
    <release version="0.1.1" date="2026-07-01">
      <description>
        <p>Adds RTMP output (16 kHz mono) alongside SRT, a clean end of stream
          on pause, per-URL statistics, and a simplified stream address
          dialog.</p>
      </description>
    </release>
    <release version="0.1.0" date="2026-06-30">
      <description>
        <p>First release: audio capture, network checks, SRT streaming with
          auto-reconnect, and per-URL statistics.</p>
      </description>
    </release>
  </releases>
</component>
