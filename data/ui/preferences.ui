<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <template class="LintoPreferences" parent="AdwDialog">
    <property name="title" translatable="yes">Stream Address</property>
    <property name="content-width">560</property>
    <property name="content-height">480</property>
    <property name="child">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <child type="start">
              <object class="GtkButton">
                <property name="icon-name">user-trash-symbolic</property>
                <property name="tooltip-text" translatable="yes">Remove all addresses</property>
                <signal name="clicked" handler="on_clear_all"/>
              </object>
            </child>
            <child type="end">
              <object class="GtkButton">
                <property name="icon-name">list-add-symbolic</property>
                <property name="tooltip-text" translatable="yes">Add address</property>
                <signal name="clicked" handler="on_add"/>
              </object>
            </child>
            <child type="end">
              <object class="GtkButton">
                <property name="icon-name">folder-open-symbolic</property>
                <property name="tooltip-text" translatable="yes">Import addresses from a CSV file</property>
                <signal name="clicked" handler="on_import"/>
              </object>
            </child>
          </object>
        </child>
        <property name="content">
          <object class="AdwToastOverlay" id="toast_overlay">
            <property name="child">
              <object class="AdwPreferencesPage">
                <child>
                  <object class="AdwPreferencesGroup" id="addresses_group">
                    <property name="title" translatable="yes">Addresses</property>
                    <property name="description" translatable="yes">Pick the address to stream to. Add several and switch between them.</property>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
