<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <object class="GtkAdjustment" id="srt_latency_adjustment">
    <property name="lower">20</property>
    <property name="upper">8000</property>
    <property name="step-increment">10</property>
    <property name="page-increment">100</property>
  </object>
  <object class="GtkAdjustment" id="silence_adjustment">
    <property name="lower">10</property>
    <property name="upper">3600</property>
    <property name="step-increment">5</property>
    <property name="page-increment">30</property>
  </object>
  <object class="GtkAdjustment" id="voice_threshold_adjustment">
    <property name="lower">-90</property>
    <property name="upper">0</property>
    <property name="step-increment">1</property>
    <property name="page-increment">5</property>
  </object>
  <object class="GtkAdjustment" id="port_adjustment">
    <property name="lower">1</property>
    <property name="upper">65535</property>
    <property name="step-increment">1</property>
    <property name="page-increment">10</property>
  </object>
  <template class="LintoSettingsDialog" parent="AdwDialog">
    <property name="title" translatable="yes">Settings</property>
    <property name="content-width">480</property>
    <property name="child">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar"/>
        </child>
        <property name="content">
          <object class="AdwToastOverlay" id="toast_overlay">
            <property name="child">
              <object class="AdwPreferencesPage">
                <child>
                  <object class="AdwPreferencesGroup">
                    <property name="title" translatable="yes">Streaming</property>
                    <child>
                      <object class="AdwSpinRow" id="srt_latency_row">
                        <property name="title" translatable="yes">SRT latency (ms)</property>
                        <property name="subtitle" translatable="yes">Higher values drop fewer packets on a jittery link, at the cost of delay.</property>
                        <property name="adjustment">srt_latency_adjustment</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwPreferencesGroup">
                    <property name="title" translatable="yes">Auto-pause</property>
                    <property name="description" translatable="yes">Streaming pauses automatically after this much silence and resumes when voice is detected again. Steady background noise does not count as speech.</property>
                    <child>
                      <object class="AdwSpinRow" id="silence_row">
                        <property name="title" translatable="yes">Pause after silence (s)</property>
                        <property name="adjustment">silence_adjustment</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwSwitchRow" id="voice_threshold_auto_row">
                        <property name="title" translatable="yes">Automatic voice threshold</property>
                        <property name="subtitle" translatable="yes">Learn the silence level from the recent loudest audio.</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwSpinRow" id="voice_threshold_row">
                        <property name="title" translatable="yes">Voice level threshold (dBFS)</property>
                        <property name="subtitle" translatable="yes">Audio below this level counts as silence. Set it above the input level meter's background noise.</property>
                        <property name="adjustment">voice_threshold_adjustment</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwPreferencesGroup">
                    <property name="title" translatable="yes">Stream Deck Controller server</property>
                    <property name="description" translatable="yes">Let Stream Controller start and pause streaming over the network.</property>
                    <child>
                      <object class="AdwSwitchRow" id="enable_row">
                        <property name="title" translatable="yes">Enable server</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwSpinRow" id="port_row">
                        <property name="title" translatable="yes">Port</property>
                        <property name="adjustment">port_adjustment</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="password_row">
                        <property name="title" translatable="yes">Password</property>
                        <property name="subtitle" translatable="yes">Click to copy</property>
                        <property name="activatable">true</property>
                        <signal name="activated" handler="on_password_activated"/>
                        <child type="suffix">
                          <object class="GtkButton" id="generate_button">
                            <property name="label" translatable="yes">Generate Password</property>
                            <property name="valign">center</property>
                            <signal name="clicked" handler="on_generate"/>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="address_row">
                        <property name="title" translatable="yes">Address</property>
                        <property name="tooltip-text" translatable="yes">Click to copy</property>
                        <property name="activatable">true</property>
                        <signal name="activated" handler="on_address_activated"/>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="status_row">
                        <property name="title" translatable="yes">Status</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
